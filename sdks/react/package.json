{
  "name": "@streampay/react",
  "version": "0.1.0",
  "description": "React 19 hooks and wallet provider for the typed StreamPay SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-storybook": "storybook build --quiet",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@streampay/sdk": "^0.3.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.6",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "storybook": "10.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.1"
  }
}
